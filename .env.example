# Kit (antigo ConvertKit) — https://app.kit.com
# API Key: Settings > Developer > API Keys (usa a "API Key", não o "API Secret")
KIT_API_KEY=
# ID numérico do formulário de newsletter (aparece na URL do formulário no painel do Kit)
KIT_FORM_ID=
# ID numérico do formulário do e-book "Desafios de 21 Dias" (página /21dias)
KIT_EBOOK_FORM_ID=
# Link direto do PDF do e-book. Só é enviado ao navegador de quem JÁ era inscrito
# (esses não recebem de novo o e-mail de entrega do Kit). Deixe vazio para não mostrar o link.
KIT_EBOOK_PDF_URL=

# Google Analytics 4 — Admin > Fluxos de dados > (seu fluxo) > ID de mensuração (formato G-XXXXXXX)
PUBLIC_GA_ID=
