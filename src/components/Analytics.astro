---
// Google Analytics 4. Defina PUBLIC_GA_ID no .env (veja .env.example) para ativar —
// sem a variável, este componente não renderiza nada.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{gaId && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
