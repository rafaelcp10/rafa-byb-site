---
import { Image } from 'astro:assets';
import Badge from './Badge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  artigo: CollectionEntry<'artigos'>;
}

const { artigo } = Astro.props;
const { titulo, resumo, registro, imagem_capa, tempo_leitura, tempo_video } = artigo.data;
const registroLabel = registro === 'humano' ? 'Humano' : 'Execução';
const meta = tempo_video ? `${tempo_video} de vídeo · ${tempo_leitura} de leitura` : tempo_leitura;
---

<a class="article-card" href={`/artigos/${artigo.data.slug}`}>
  <div class="article-card__media">
    <Image
      src={imagem_capa}
      alt={titulo}
      width={480}
      height={270}
      widths={[280, 380, 480]}
      sizes="(min-width: 900px) 33vw, (min-width: 600px) 45vw, 90vw"
    />
  </div>
  <div class="article-card__body">
    <div class="article-card__meta">
      <Badge tone={registro}>{registroLabel}</Badge>
      <span class="article-card__meta-text">{meta}</span>
    </div>
    <h3 class="article-card__title">{titulo}</h3>
    <p class="article-card__resumo">{resumo}</p>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      transform var(--duration-base) var(--ease-standard),
      border-color var(--duration-base) var(--ease-standard),
      box-shadow var(--duration-base) var(--ease-standard);
  }
  .article-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .article-card__media {
    border-radius: var(--radius-sm);
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }
  .article-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .article-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .article-card__meta-text {
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
  .article-card__title {
    font-size: var(--text-h4);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    font-weight: var(--weight-medium);
    text-wrap: pretty;
  }
  .article-card__resumo {
    font-size: var(--text-small);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
  }
</style>
