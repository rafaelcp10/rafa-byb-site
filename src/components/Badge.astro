---
interface Props {
  tone?: 'execucao' | 'humano' | 'neutral' | 'success' | 'warning' | 'error';
  class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 24px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-xs);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .badge--execucao { background: var(--alpha-oliva-32); color: var(--color-off-white); }
  .badge--humano { background: var(--color-verde-areia); color: var(--color-chumbo-800); }
  .badge--neutral { background: var(--alpha-off-white-08); color: var(--text-secondary); }
  .badge--success { background: var(--color-success); color: var(--color-off-white); }
  .badge--warning { background: var(--color-warning); color: var(--color-chumbo-800); }
  .badge--error { background: var(--color-error); color: var(--color-off-white); }
</style>
