---
import Wordmark from './Wordmark.astro';
import { CATEGORIA_LIST } from '../data/categorias';
import { SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark mark="wordmark" size="sm" />
      <p>Torne-se a pessoa que você sabe que pode ser.</p>
    </div>
    <div class="site-footer__col">
      <span class="site-footer__heading">Conteúdo</span>
      <a href="/#artigos">Artigos</a>
      <a href="/sobre">Sobre</a>
      <span class="site-footer__muted">Produtos (em breve)</span>
    </div>
    <div class="site-footer__col">
      <span class="site-footer__heading">Categorias</span>
      {CATEGORIA_LIST.map((c) => <a href={`/categoria/${c.slug}`}>{c.curto}</a>)}
    </div>
    <div class="site-footer__col">
      <span class="site-footer__heading">Contato</span>
      <div class="site-footer__socials">
        <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="6" width="19" height="12" rx="3.5"/><path d="M10.5 9.5v5l4.5-2.5-4.5-2.5Z" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <!-- TODO: Rafael vai passar o e-mail de contato definitivo -->
        <a href={SOCIAL_LINKS.email} aria-label="E-mail">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>
        </a>
        <a href="/rss.xml" aria-label="RSS">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="5.5" cy="18.5" r="1.6" fill="currentColor" stroke="none"/><path d="M4 12.5a7.5 7.5 0 0 1 7.5 7.5"/><path d="M4 6.5A13.5 13.5 0 0 1 17.5 20"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <div class="container">© {year} Rafa Byb — Be Your Best</div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: var(--space-9);
    background: var(--surface-sunken);
  }
  .site-footer__inner {
    padding-block: var(--space-8);
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
  }
  .site-footer__brand {
    flex: 1 1 280px;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .site-footer__brand p {
    font-size: var(--text-small);
    color: var(--text-muted);
    max-width: 34ch;
    margin: 0;
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .site-footer__col a,
  .site-footer__muted {
    font-size: var(--text-small);
    color: var(--text-secondary);
    text-decoration: none;
    border-bottom: none;
  }
  .site-footer__col a:hover { color: var(--text-primary); }
  .site-footer__muted { color: var(--text-muted); }
  .site-footer__socials {
    display: flex;
    gap: var(--space-3);
  }
  .site-footer__socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-standard), border-color var(--duration-fast) var(--ease-standard);
  }
  .site-footer__socials a:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }
  .site-footer__socials svg {
    width: 18px;
    height: 18px;
  }
  .site-footer__heading {
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .site-footer__bottom {
    border-top: 1px solid var(--border-subtle);
  }
  .site-footer__bottom .container {
    padding-block: var(--space-4);
    font-size: var(--text-caption);
    color: var(--text-muted);
  }
</style>
