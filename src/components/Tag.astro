---
interface Props {
  active?: boolean;
  href?: string;
  class?: string;
  [dataAttr: `data-${string}`]: unknown;
}

const { active = false, href, class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  {...rest}
  href={href}
  type={href ? undefined : 'button'}
  aria-pressed={href ? undefined : active}
  class:list={['tag', { 'tag--active': active }, className]}
>
  <slot />
</Tag>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 32px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    cursor: pointer;
    text-decoration: none;
    border: 1px solid var(--border-default);
    background: transparent;
    color: var(--text-secondary);
    transition: all var(--duration-fast) var(--ease-standard);
  }
  .tag:hover { background: var(--alpha-off-white-08); }
  .tag--active {
    border-color: var(--border-accent);
    background: var(--surface-accent-soft);
    color: var(--text-primary);
  }
  .tag--active:hover { background: var(--surface-accent-soft); }
</style>
