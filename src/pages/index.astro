---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Badge from '../components/Badge.astro';
import Tag from '../components/Tag.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterBand from '../components/NewsletterBand.astro';
import RevealText from '../components/RevealText.astro';
import heroImg from '../assets/site/hero-cinematic.png';
import fotoRafael from '../assets/site/foto4.png';
import { CATEGORIA_LIST } from '../data/categorias';
import { SITE_DESCRIPTION } from '../consts';

const artigos = (await getCollection('artigos')).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf()
);
const destaque = artigos[0];
const resto = artigos.slice(1);

const dataFormatada = destaque
  ? new Intl.DateTimeFormat('pt-BR', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(
      destaque.data.data
    )
  : null;

const registroLabelDestaque = destaque?.data.registro === 'humano' ? 'Humano' : 'Execução';
const metaDestaque = destaque
  ? destaque.data.tempo_video
    ? `${destaque.data.tempo_video} de vídeo · ${destaque.data.tempo_leitura} de leitura`
    : destaque.data.tempo_leitura
  : '';
---

<BaseLayout title="Rafa Byb — Be Your Best" description={SITE_DESCRIPTION}>
  <main>
    <section class="hero" data-hero>
      <div class="hero__stage" data-hero-stage>
        <Image
          src={heroImg}
          alt="Pico de montanha ao amanhecer, emergindo de um mar de névoa"
          class="hero__img"
          data-hero-img
          widths={[900, 1400, 1920, 2560]}
          sizes="100vw"
          priority
        />
        <div class="hero__grain grain-overlay"></div>
        <div class="hero__gradient"></div>
        <div class="hero__vignette"></div>
      </div>

      <div class="container hero__content" data-hero-content>
        <div class="hero__top">
          <Eyebrow>Um conteúdo por semana</Eyebrow>
        </div>
        <RevealText as="h1" text="Você não precisa se tornar outra pessoa." class="hero__title" />
        <p class="hero__lede" data-reveal-fade>
          Precisa construir, todos os dias, a melhor versão de si mesmo. Aqui ficam os vídeos em
          texto: uma ideia, uma perspectiva e uma ação para aplicar hoje.
        </p>
      </div>

      <div class="hero__scrollcue" data-reveal-fade>
        <span class="hero__scrollcue-line"></span>
        <span class="hero__scrollcue-label">Role para continuar</span>
      </div>
    </section>

    {destaque && (
      <section class="container destaque" data-reveal-section>
        <div class="destaque__label" data-reveal-fade>
          <span>Último conteúdo</span>
          <span class="destaque__data">{dataFormatada}</span>
        </div>
        <a href={`/artigos/${destaque.data.slug}`} class="destaque__grid">
          <div class="destaque__media" data-parallax-media>
            <Image
              src={destaque.data.imagem_capa}
              alt={destaque.data.titulo}
              width={640}
              height={360}
              widths={[360, 480, 640]}
              sizes="(min-width: 900px) 50vw, 100vw"
              data-parallax-img
            />
          </div>
          <div class="destaque__copy" data-reveal-up>
            <div class="destaque__meta">
              <Badge tone={destaque.data.registro}>{registroLabelDestaque}</Badge>
              <span class="destaque__meta-text">{metaDestaque}</span>
            </div>
            <h2>{destaque.data.titulo}</h2>
            <p>{destaque.data.resumo}</p>
            <span class="destaque__cta">Ler o artigo e assistir</span>
          </div>
        </a>
      </section>
    )}

    <section class="container artigos" id="artigos" data-reveal-section>
      <div class="artigos__head" data-reveal-up>
        <h2>Artigos</h2>
        <div class="artigos__filtros" data-filtros>
          <Tag active data-filtro="todos">Todos</Tag>
          {CATEGORIA_LIST.map((c) => (
            <Tag data-filtro={c.id}>{c.curto}</Tag>
          ))}
        </div>
      </div>

      {resto.length === 0 ? (
        <p class="artigos__vazio" data-reveal-up>Mais artigos chegam nas próximas semanas.</p>
      ) : (
        <div class="artigos__grid" data-grid>
          {resto.map((a) => (
            <div data-categoria={a.data.categoria} data-reveal-card>
              <ArticleCard artigo={a} />
            </div>
          ))}
        </div>
      )}
    </section>

    <section class="container sobre-teaser" data-reveal-section>
      <div class="sobre-teaser__grid">
        <div class="sobre-teaser__photo" data-parallax-media>
          <Image
            src={fotoRafael}
            alt="Foto de Rafael"
            width={480}
            height={480}
            widths={[240, 320, 480]}
            sizes="(min-width: 900px) 320px, 45vw"
            data-parallax-img
          />
        </div>
        <div class="sobre-teaser__copy" data-reveal-up>
          <Eyebrow>Quem escreve</Eyebrow>
          <h2>Eu sou Rafael.</h2>
          <p>
            Levei anos no piloto automático antes de entender que disciplina não é castigo: é a
            forma mais direta de cuidar de quem você quer ser. Hoje construo isso todos os dias,
            com trabalho, treino e família no mesmo lugar.
          </p>
          <p>
            Aqui não tem motivação vazia nem promessa de sete dias. Tem uma ideia por semana,
            testada na minha própria rotina, com uma ação para você aplicar hoje.
          </p>
          <a href="/sobre" class="sobre-teaser__link">Conhecer a minha história</a>
        </div>
      </div>
    </section>

    <div data-reveal-section>
      <NewsletterBand />
    </div>
  </main>
</BaseLayout>

<script>
  const filtros = document.querySelector('[data-filtros]');
  const grid = document.querySelector('[data-grid]');

  filtros?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-filtro]') as HTMLElement | null;
    if (!btn) return;
    const filtro = btn.dataset.filtro;

    filtros.querySelectorAll('[data-filtro]').forEach((el) => el.setAttribute('aria-pressed', 'false'));
    btn.setAttribute('aria-pressed', 'true');

    grid?.querySelectorAll<HTMLElement>('[data-categoria]').forEach((card) => {
      const show = filtro === 'todos' || card.dataset.categoria === filtro;
      card.style.display = show ? '' : 'none';
    });
  });
</script>

<script>
  import { initScrollMotion } from '../scripts/scroll-motion';

  const motion = initScrollMotion();

  if (motion) {
    const { gsap } = motion;

    // --- Hero: revela o título palavra por palavra ao carregar ---
    const heroWords = document.querySelectorAll('[data-hero] .reveal-text__word');

    // O lede fica visível desde o primeiro frame (é o candidato a LCP da página —
    // escondê-lo atrás de uma animação atrasaria essa métrica real). Só o scrollcue,
    // puramente decorativo, entra com fade.
    const heroFadeIns = [document.querySelector('.hero__scrollcue')];
    gsap.set(heroFadeIns, { autoAlpha: 0, y: 16 });

    const introTl = gsap.timeline({ delay: 0.15 });
    introTl
      .to(heroWords, {
        y: 0,
        duration: 1.1,
        ease: 'expo.out',
        stagger: 0.06,
      })
      .to(
        heroFadeIns,
        { autoAlpha: 1, y: 0, duration: 0.8, ease: 'power2.out', stagger: 0.1 },
        '-=0.6'
      );

    // --- Hero: pin + parallax + fade enquanto rola ---
    gsap.timeline({
      scrollTrigger: {
        trigger: '[data-hero]',
        start: 'top top',
        end: '+=85%',
        pin: true,
        scrub: 0.6,
      },
    })
      .to('[data-hero-img]', { scale: 1.18, ease: 'none' }, 0)
      .to('[data-hero-content]', { autoAlpha: 0, y: -80, ease: 'none' }, 0)
      .to('.hero__scrollcue', { autoAlpha: 0, ease: 'none' }, 0);
  }
</script>

<style>
  /* ---- Hero cinematográfico ---- */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-chumbo-950);
  }
  .hero__stage {
    position: absolute;
    inset: 0;
    z-index: var(--layer-bg);
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  .hero__gradient {
    position: absolute;
    inset: 0;
    z-index: var(--layer-mist);
    background: linear-gradient(
      to top,
      var(--color-chumbo-950) 0%,
      rgba(10, 10, 12, 0.85) 22%,
      rgba(10, 10, 12, 0.25) 52%,
      rgba(10, 10, 12, 0.05) 75%
    );
  }
  .hero__vignette {
    position: absolute;
    inset: 0;
    z-index: var(--layer-mist);
    box-shadow: inset 0 0 min(22vw, 260px) rgba(0, 0, 0, 0.65);
  }
  .hero__content {
    position: relative;
    z-index: var(--layer-content);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-9);
  }
  .hero__top { display: flex; }
  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    font-weight: var(--weight-semibold);
    color: var(--color-off-white);
    max-width: 16ch;
    text-wrap: balance;
  }
  .hero__lede {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 46ch;
    margin: var(--space-2) 0 0;
  }
  .hero__scrollcue {
    position: absolute;
    left: var(--gutter-page);
    bottom: var(--space-5);
    z-index: var(--layer-content);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  @media (min-width: 900px) {
    .hero__scrollcue { left: var(--gutter-page-lg); }
  }
  .hero__scrollcue-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-oliva), transparent);
  }
  .hero__scrollcue-label {
    font-size: var(--text-caption);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--alpha-off-white-64);
    writing-mode: vertical-rl;
  }

  /* ---- Seções seguintes: mesma base, com respiro maior ---- */
  .destaque { padding-top: var(--space-9); }
  .destaque__label {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-caption);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .destaque__data { margin-left: auto; text-transform: none; font-weight: var(--weight-regular); }
  .destaque__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    padding-bottom: var(--space-9);
    text-decoration: none;
    color: inherit;
  }
  .destaque__media {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    aspect-ratio: 16 / 9;
    isolation: isolate;
  }
  .destaque__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .destaque__copy { display: flex; flex-direction: column; gap: var(--space-4); }
  .destaque__meta { display: flex; align-items: center; gap: var(--space-3); }
  .destaque__meta-text { font-size: var(--text-caption); color: var(--text-muted); }
  .destaque__copy h2 {
    font-size: clamp(var(--text-h2), 3.6vw, 3.4rem);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
    font-weight: var(--weight-semibold);
    text-wrap: pretty;
  }
  .destaque__copy p {
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 52ch;
    margin: 0;
  }
  .destaque__cta {
    font-size: var(--text-small);
    color: var(--text-accent);
    border-bottom: 1px solid var(--alpha-oliva-32);
    align-self: flex-start;
    padding-bottom: 2px;
  }
  @media (min-width: 900px) {
    .destaque__grid { grid-template-columns: 1.05fr 0.95fr; }
  }

  .artigos { padding-top: var(--space-6); }
  .artigos__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    border-top: 1px solid var(--border-subtle);
    padding: var(--space-6) 0 var(--space-5);
  }
  .artigos__head h2 {
    font-size: clamp(var(--text-h2), 3vw, 2.75rem);
    letter-spacing: var(--tracking-heading);
    font-weight: var(--weight-medium);
  }
  .artigos__filtros { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .artigos__vazio {
    font-size: var(--text-body);
    color: var(--text-secondary);
    padding-bottom: var(--space-6);
  }
  .artigos__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
    padding-bottom: var(--space-6);
  }

  .sobre-teaser { padding-top: var(--space-9); }
  .sobre-teaser__grid {
    border-top: 1px solid var(--border-subtle);
    padding-block: var(--space-9);
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  .sobre-teaser__photo {
    max-width: 320px;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }
  .sobre-teaser__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sobre-teaser__copy { display: flex; flex-direction: column; gap: var(--space-4); }
  .sobre-teaser__copy h2 {
    font-size: clamp(var(--text-h2), 3.4vw, 3.2rem);
    letter-spacing: var(--tracking-heading);
    font-weight: var(--weight-medium);
    text-wrap: pretty;
  }
  .sobre-teaser__copy p {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    max-width: 56ch;
    margin: 0;
  }
  .sobre-teaser__link {
    font-size: var(--text-small);
    color: var(--text-accent);
    border-bottom: 1px solid var(--alpha-oliva-32);
    align-self: flex-start;
    padding-bottom: 2px;
    text-decoration: none;
  }
  @media (min-width: 900px) {
    .sobre-teaser__grid { grid-template-columns: 320px minmax(0, 1fr); }
  }
</style>
